package Om;

public class Assgement {
	public static void main(String[] args) {
		import java.util.ArrayList;
		import java.util.Scanner;

		/**
		 * Course class represents Course entity (Model Layer)
		 */
		class Course {
		    int courseId;
		    String courseName;
		    double courseFees;
		    String courseDuration;
		    String courseDetail;

		    public Course(int courseId, String courseName, double courseFees, String courseDuration, String courseDetail) {
		        this.courseId = courseId;
		        this.courseName = courseName;
		        this.courseFees = courseFees;
		        this.courseDuration = courseDuration;
		        this.courseDetail = courseDetail;
		    }

		    // Display formatted course details
		    public void display() {
		        System.out.println("--------------------------------------------------");
		        System.out.println("Course ID       : " + courseId);
		        System.out.println("Course Name     : " + courseName);
		        System.out.println("Course Fees     : " + courseFees);
		        System.out.println("Course Duration : " + courseDuration);
		        System.out.println("Course Detail   : " + courseDetail);
		        System.out.println("--------------------------------------------------");
		    }
		}

		/**
		 * CourseService class handles business logic (Service Layer)
		 */
		class CourseService {
		    Scanner sc = new Scanner(System.in);
		    ArrayList<Course> courseList = new ArrayList<>();

		    /**
		     * Add a new course (C - CREATE)
		     */
		    public void addCourse() {
		        System.out.println("--------- Add New Course ---------");
		        System.out.print("Course ID       : ");
		        int id = sc.nextInt();
		        sc.nextLine();

		        System.out.print("Course Name     : ");
		        String name = sc.nextLine();

		        System.out.print("Course Fees     : ");
		        double fees = sc.nextDouble();
		        sc.nextLine();

		        System.out.print("Course Duration : ");
		        String duration = sc.nextLine();

		        System.out.print("Course Detail   : ");
		        String detail = sc.nextLine();

		        courseList.add(new Course(id, name, fees, duration, detail));
		        System.out.println("\nCourse added successfully!");
		    }

		    /**
		     * View all courses (R - READ)
		     */
		    public void viewCourses() {
		        System.out.println("--------- List of All Courses ---------");
		        if (courseList.isEmpty()) {
		            System.out.println("No courses found!");
		            return;
		        }
		        for (Course c : courseList) {
		            c.display();
		        }
		    }

		    /**
		     * Search course by ID
		     */
		    public void searchCourse() {
		        System.out.print("Enter Course ID to Search: ");
		        int id = sc.nextInt();
		        for (Course c : courseList) {
		            if (c.courseId == id) {
		                System.out.println("Course Found:");
		                c.display();
		                return;
		            }
		        }
		        System.out.println("Course Not Found!");
		    }

		    /**
		     * Edit course by ID (U - UPDATE)
		     */
		    public void editCourse() {
		        System.out.print("Course ID For Edit: ");
		        int id = sc.nextInt();
		        sc.nextLine();

		        for (Course c : courseList) {
		            if (c.courseId == id) {

		                System.out.print("New Course Name     : ");
		                c.courseName = sc.nextLine();

		                System.out.print("New Course Fees     : ");
		                c.courseFees = sc.nextDouble();
		                sc.nextLine();

		                System.out.print("New Course Duration : ");
		                c.courseDuration = sc.nextLine();

		                System.out.print("New Course Detail   : ");
		                c.courseDetail = sc.nextLine();

		                System.out.println("\nCourse Updated Successfully!");
		                return;
		            }
		        }
		        System.out.println("Course Not Found!");
		    }

		    /**
		     * Delete course by ID (D - DELETE)
		     */
		    public void deleteCourse() {
		        System.out.print("Course ID For Delete: ");
		        int id = sc.nextInt();
		        for (Course c : courseList) {
		            if (c.courseId == id) {
		                courseList.remove(c);
		                System.out.println("Course Deleted Successfully!");
		                return;
		            }
		        }
		        System.out.println("Course Not Found!");
		    }
		}


		/**
		 * Main class -> Console-based UI (Controller Layer)
		 */
		public class CourseManagementSystem {

		    public static void main(String[] args) {
		        Scanner sc = new Scanner(System.in);
		        CourseService cs = new CourseService();

		        while (true) {
		            System.out.println("\n========= Course Management System =========");
		            System.out.println("1. Add Course");
		            System.out.println("2. View Course");
		            System.out.println("3. Search Course");
		            System.out.println("4. Edit Course");
		            System.out.println("5. Delete Course");
		            System.out.println("6. Exit");
		            System.out.println("--------------------------------------------");
		            System.out.print("Enter Your Choice: ");

		            int choice = sc.nextInt();

		            switch (choice) {
		                case 1:
		                    cs.addCourse();
		                    break;
		                case 2:
		                    cs.viewCourses();
		                    break;
		                case 3:
		                    cs.searchCourse();
		                    break;
		                case 4:
		                    cs.editCourse();
		                    break;
		                case 5:
		                    cs.deleteCourse();
		                    break;
		                case 6:
		                    System.out.println("Thank you! Exiting Program...");
		                    System.exit(0);
		                default:
		                    System.out.println("Invalid Choice! Try Again!");
		            }
		        }
		    }
		}

	}
}