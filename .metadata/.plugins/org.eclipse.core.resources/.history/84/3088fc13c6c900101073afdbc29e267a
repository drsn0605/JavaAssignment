class CounterWithoutStatic {
    int count = 0;  // non-static variable

    CounterWithoutStatic() {
        count++; 
        System.out.println("Count = " + count);
    }
}

public class WithoutStatic {
    public static void main(String[] args) {
        CounterWithoutStatic obj1 = new CounterWithoutStatic(); // Count = 1
        CounterWithoutStatic obj2 = new CounterWithoutStatic(); // Count = 1
        CounterWithoutStatic obj3 = new CounterWithoutStatic(); // Count = 1
    }
}

